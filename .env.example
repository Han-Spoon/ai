# 로컬 테스트에서만 true로 사용.
OCR_ALLOW_HTTP=false

# LLM — OpenAI
OPENAI_API_KEY=your_openai_api_key
# 선택. 미지정 시 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
