# OCR — 네이버 클라우드 CLOVA OCR
CLOVA_OCR_URL=https://2g2jg1ctyf.apigw.ntruss.com/custom/v1/57799/af34c9e979e948bd9886df5c584d751bd9b3aaec7a587bace639bfdd896af7c0/general
CLOVA_OCR_SECRET=your_clova_ocr_secret

CLOVA_OCR_TIMEOUT_SECONDS=60
CLOVA_OCR_MAX_ATTEMPTS=3
