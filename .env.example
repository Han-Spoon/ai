# OCR — 네이버 클라우드 CLOVA OCR
CLOVA_OCR_URL=https://...apigw.ntruss.com/custom/v1/.../general
CLOVA_OCR_SECRET=your_clova_ocr_secret

CLOVA_OCR_TIMEOUT_SECONDS=10
CLOVA_OCR_MAX_ATTEMPTS=2
CLOVA_OCR_MAX_CALLS_PER_SCAN=2
CLOVA_OCR_MIN_INTERVAL_SECONDS=1.0

# 사용자 대기 경로의 전체 시간 예산
OCR_REQUEST_BUDGET_SECONDS=16
OCR_TOTAL_BUDGET_SECONDS=14
OCR_QUALITY_RETRY_MIN_REMAINING_SECONDS=8
OCR_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=5
OCR_MAX_CONCURRENT_SCANS=2
OCR_QUEUE_WAIT_SECONDS=1

# 운영 권장: ECS task role + S3 Gateway Endpoint로 원본을 읽음.
# 활성화하면 storage_key를 우선 사용하고 image_url은 호환성용 fallback이 됨.
OCR_S3_FETCH_ENABLED=false
OCR_S3_BUCKET=hanspoon-prod-images-917dedbe
AWS_REGION=ap-northeast-2

OCR_ALLOWED_IMAGE_HOSTS=
OCR_REQUIRE_IMAGE_HOST_ALLOWLIST=false
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PREPROCESS_MAX_PIXELS=20000000
# 로컬 테스트에서만 true로 사용.
OCR_ALLOW_HTTP=false

# FastAPI /v1/ocr의 latency-critical 경로에서는 기본 false.
OCR_ENABLE_GPT_POST_PROCESS=false
OCR_ENABLE_GPT_JUDGMENT=false

# LLM — OpenAI 호환 (②⑥⑧ 공용). 키가 없으면 ②⑥⑧은 LLM 없이 규칙만으로 돈다.
OPENAI_API_KEY=your_openai_api_key
# 선택. OpenAI 호환 게이트웨이(예: 학교 BAZE)를 쓸 때만. SDK가 직접 읽는다.
OPENAI_BASE_URL=
# 선택. ① OCR 후처리(ai_ocr) 모델. 미지정 시 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5
# ⑥ 웹 검색 — 네이버 클라우드 NAVER API HUB 키 (웹문서·블로그 검색). 둘은 함께 넣는다
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 선택. ⑥ 레시피 판별 LLM (기본 gpt-5.4-mini, 시간 제한 3초)
WEB_SEARCH_OPENAI_MODEL=
WEB_SEARCH_OPENAI_TIMEOUT_SECONDS=
# 선택. ⑧ 이유 문장·고위험 재검증 LLM (기본 gpt-5.4-mini, 5초, 재시도 1회)
XAI_OPENAI_MODEL=
XAI_OPENAI_TIMEOUT_SECONDS=
XAI_OPENAI_MAX_RETRIES=
